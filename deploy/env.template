# scheduling-api environment (installed to /opt/scheduling/.env, mode 0600).
# All values are non-secret. Written at provision time by
# web-api/deploy/setup-server.sh (and by scheduling-bootstrap.sh on an existing
# droplet); this file documents the expected contents.

# Bind the native binary to host loopback only. Traefik (rootless) reaches it
# via the slirp host-loopback address host.docker.internal -> 10.0.2.2:8090.
ADDR=127.0.0.1:8090

# SQLite DB path — under the systemd unit's ReadWritePaths=/opt/scheduling/data.
DATABASE_PATH=/opt/scheduling/data/scheduling.db

# HTTPS everywhere → mark the session cookie Secure.
COOKIE_SECURE=true

# LOAD-BEARING, exact match (scheme+host, no trailing slash/port): the API
# returns 403 for same-origin POSTs whose Origin is not allowlisted. The web
# app is served same-origin at https://scheduling.birb.party.
ALLOWED_ORIGINS=https://scheduling.birb.party
